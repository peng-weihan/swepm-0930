+def _has_recovery_prefix(value, prefix):
+    """Recognize previous generated content anywhere in public message content.
+
+    Roles, prompt wording, ordering, and content-block representation may differ.
+    JSON-encoded context is decoded, without matching a private helper format.
+    """
+    if isinstance(value, str):
+        if prefix in value:
+            return True
+        try:
+            decoded = json.loads(value)
+        except (ValueError, TypeError):
+            return False
+        return decoded != value and _has_recovery_prefix(decoded, prefix)
+    if isinstance(value, dict):
+        return any(_has_recovery_prefix(item, prefix) for item in value.values())
+    if isinstance(value, (list, tuple)):
+        return any(_has_recovery_prefix(item, prefix) for item in value)
+    return False
+
+
+def _client_with_recovery_responses(first_stream, recovery_chunks, *, prefix):
+    """Distinguish retries from continuation by public request semantics.
+
+    Requests without the prior generated prefix receive the same truncated
+    answer again. Requests carrying that context receive a complete continuation.
+    No attempt count, private retry budget, or exact recovery prompt is assumed.
+    """
+    observations = {"initial_or_retry": 0, "continuation": 0}
+
+    async def create(**kwargs):
+        if not _has_recovery_prefix(kwargs.get("messages", []), prefix):
+            observations["initial_or_retry"] += 1
+            return first_stream
+        observations["continuation"] += 1
+        return AsyncStreamMock(recovery_chunks)
+
+    client = SimpleNamespace(
+        chat=SimpleNamespace(completions=SimpleNamespace(create=AsyncMock(side_effect=create))),
+        close=AsyncMock(),
+    )
+    return client, observations
+
