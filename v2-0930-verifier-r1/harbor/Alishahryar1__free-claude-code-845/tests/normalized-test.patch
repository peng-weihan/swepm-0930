+"""Diagnostic replacement for one source-spelling assertion.
+Real provider streams and retry/blocking implementation remain active; only fake
+HTTP/client responses and the existing limiter clock/sleep boundary are controlled.
+No scope-name, mapper path, local identifier, or blocking-helper call is graded.
+"""
+
+import asyncio
+import time
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import httpx
+import openai
+import pytest
+
+from providers.base import ProviderConfig
+from providers.rate_limit import GlobalRateLimiter
+from providers.transports.anthropic_messages import AnthropicMessagesTransport
+from providers.transports.openai_chat import OpenAIChatTransport
+from tests.stream_contract import assert_canonical_stream_error_envelope
+
+
+class Scoped429Request:
+    model = "scoped-control-model"
+    thinking = None
+    tools = []
+
+    def model_dump(self, exclude_none=True):
+        return {
+            "model": self.model,
+            "messages": [{"role": "user", "content": "Hello"}],
+            "max_tokens": 32,
+        }
+
+
+class Scoped429OpenAIProvider(OpenAIChatTransport):
+    def _build_request_body(self, request, thinking_enabled=None):
+        return request.model_dump()
+
+
+def _sse_events(text):
+    """Independent wire parsing: no production formatter/parser in expected data."""
+    result = []
+    for block in text.split("\n\n"):
+        data = [line[5:].strip() for line in block.splitlines() if line.startswith("data:")]
+        if data:
+            result.append(json.loads("\n".join(data)))
+    return result
+
+
+@pytest.mark.parametrize("transport_family", ["openai_chat", "anthropic_messages"])
+@pytest.mark.asyncio
+async def test_streaming_transports_scope_reactive_429_without_blocking_other_provider(
+    monkeypatch, transport_family
+):
+    # Keep the real retry implementation. Only its clock/sleep boundary is
+    # controlled; the score never requires error mapping at a particular site.
+    GlobalRateLimiter.reset_instance()
+    from providers import rate_limit as limiter_module
+    clock = [time.monotonic()]
+    monkeypatch.setattr(limiter_module, "time", SimpleNamespace(monotonic=lambda: clock[0]))
+    phase = ["construct"]
+    sleep_observations = []
+    request = Scoped429Request()
+    actual_calls = {"a": 0, "b": 0}
+    providers = []
+    names = {"a": "SCOPED_CONTROL_A", "b": "SCOPED_CONTROL_B"}
+    config = ProviderConfig(api_key="local-fixture", rate_limit=100, rate_window=60)
+
+    async def success_stream():
+        yield SimpleNamespace(
+            choices=[SimpleNamespace(
+                delta=SimpleNamespace(content="provider-b-ready", reasoning_content=None, tool_calls=None),
+                finish_reason="stop",
+            )],
+            usage=SimpleNamespace(prompt_tokens=1, completion_tokens=1),
+        )
+
+    def make_openai_client(**kwargs):
+        side = "a" if "provider-a.test" in kwargs["base_url"] else "b"
+
+        async def create(**body):
+            actual_calls[side] += 1
+            if side == "a":
+                response = httpx.Response(429, request=httpx.Request("POST", kwargs["base_url"]))
+                raise openai.RateLimitError("fixture429", response=response, body={"error": {"message": "fixture429"}})
+            return success_stream()
+
+        return SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=create)), close=AsyncMock())
+
+    real_async_client = httpx.AsyncClient
+
+    def native_http(request):
+        side = "a" if request.url.host == "provider-a.test" else "b"
+        actual_calls[side] += 1
+        if side == "a":
+            return httpx.Response(429, json={"error": {"message": "fixture429"}})
+        # A complete native response with an observable payload, no recovery.
+        events = [
+            {"type": "message_start", "message": {"id": "local", "type": "message", "role": "assistant", "content": [], "model": "scoped-control-model", "usage": {"input_tokens": 1, "output_tokens": 0}}},
+            {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}},
+            {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": "provider-b-ready"}},
+            {"type": "content_block_stop", "index": 0},
+            {"type": "message_delta", "delta": {"stop_reason": "end_turn"}, "usage": {"output_tokens": 1}},
+            {"type": "message_stop"},
+        ]
+        wire = "".join("event: " + event["type"] + "\ndata: " + json.dumps(event) + "\n\n" for event in events)
+        return httpx.Response(200, content=wire.encode(), headers={"content-type": "text/event-stream"})
+
+    def make_native_client(**kwargs):
+        return real_async_client(**kwargs, transport=httpx.MockTransport(native_http))
+
+    try:
+        if transport_family == "openai_chat":
+            monkeypatch.setattr("providers.transports.openai_chat.transport.AsyncOpenAI", make_openai_client)
+            for side in ("a", "b"):
+                providers.append(Scoped429OpenAIProvider(
+                    config, provider_name=names[side], base_url=f"https://provider-{side}.test/v1", api_key="local-fixture"
+                ))
+        else:
+            monkeypatch.setattr("providers.transports.anthropic_messages.transport.httpx.AsyncClient", make_native_client)
+            for side in ("a", "b"):
+                providers.append(AnthropicMessagesTransport(
+                    config, provider_name=names[side], default_base_url=f"https://provider-{side}.test/v1"
+                ))
+
+        # Do not assume a provider-name case conversion or private scope key.
+        # Exercise B while A is inside a real reactive backoff, not only after A
+        # has finished and a buggy shared block may have expired.
+        unrelated = GlobalRateLimiter.get_instance()
+        assert not unrelated.is_blocked()
+        healthy_events = []
+        b_started = [False]
+
+        async def advance_sleep(delay, result=None):
+            active = phase[0]
+            delay = float(delay)
+            sleep_observations.append((active, delay))
+            if active == "a" and delay > 0 and not b_started[0]:
+                b_started[0] = True
+                phase[0] = "b"
+                try:
+                    healthy_events.extend([event async for event in providers[1].stream_response(request)])
+                finally:
+                    phase[0] = "a"
+            clock[0] += max(0.0, delay)
+            return result
+
+        monkeypatch.setattr(asyncio, "sleep", advance_sleep)
+        phase[0] = "a"
+        failed_events = [event async for event in providers[0].stream_response(request)]
+        assert actual_calls["a"] > 0, "429 boundary was never reached"
+        assert_canonical_stream_error_envelope(failed_events, user_message_substr="429")
+        assert any(who == "a" and delay > 0 for who, delay in sleep_observations), "A's real 429 retry/backoff path was not reached"
+        assert b_started[0] and actual_calls["b"] > 0, "B was not exercised during A's reactive backoff"
+        assert not any(who == "b" and delay > 0 for who, delay in sleep_observations), "A's 429 blocked otherwise healthy B"
+        assert not unrelated.is_blocked(), "A's 429 blocked the unrelated global fallback"
+        parsed = _sse_events("".join(healthy_events))
+        assert any(event.get("delta", {}).get("text") == "provider-b-ready" for event in parsed)
+        assert parsed[-1]["type"] == "message_stop"
+        assert not any(event.get("type") == "error" for event in parsed)
+    finally:
+        for provider in providers:
+            await provider.cleanup()
+        GlobalRateLimiter.reset_instance()
