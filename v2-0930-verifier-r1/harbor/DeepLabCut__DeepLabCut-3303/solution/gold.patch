--- /dev/null
+++ b/deeplabcut/utils/deprecation.py
@@ -0,0 +1,156 @@
+#
+# DeepLabCut Toolbox (deeplabcut.org)
+# © A. & M.W. Mathis Labs
+# https://github.com/DeepLabCut/DeepLabCut
+#
+# Please see AUTHORS for contributors.
