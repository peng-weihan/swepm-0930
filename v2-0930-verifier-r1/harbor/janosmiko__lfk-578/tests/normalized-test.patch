+				continue // no catalog row uses this key at all
+			}
+			t.Run(icons+"/"+name, func(t *testing.T) {
+				assert.Equalf(t, baseline[name], countMatches(name),
+					"a %q search must find the same rows in %s mode as in textual mode", name, icons)
+			})
+		}
+	}
+}
