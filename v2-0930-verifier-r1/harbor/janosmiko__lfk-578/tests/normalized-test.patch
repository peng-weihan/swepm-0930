+		// help case at all (update_logtop.go) — so this is the context its
+		// help section carries, reached from the log viewer's help screen.
+		modeLogTop:         "Log Top",
+		modeObjectExplorer: "Object Explorer",
+		modeEventViewer:    "Event Timeline",
+	}
