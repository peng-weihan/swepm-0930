+function assertEffect(f: ReturnType<typeof fixture>, kind: string, count: number, oldColumns: ReturnType<typeof f.columns>) {
+    if (kind === 'row') {
+        expect(f.table.getRange(), 'row insertion changes the table range').toEqual({ ...initialRange, endRow: 4 + count });
+        expect(f.columns(), 'row insertion preserves column metadata').toEqual(oldColumns);
+        expect(f.cell(1, 2), 'preceding table row is unchanged').toBe('r1c2');
+        for (let i = 0; i < count; i++) expect(f.cell(2 + i, 2), 'new row slot is empty').toBeNull();
+        expect(f.cell(2 + count, 2), 'in-table cells move down at the requested index').toBe('r2c2');
+        expect(f.cell(6 + count, 3), 'trailing cells below the table move down').toBe('r6c3');
+        expect(f.cell(2, 0), 'cells left of the table are unaffected').toBe('r2c0');
+        expect(f.cell(2, 5), 'cells right of the table are unaffected').toBe('r2c5');
+    } else if (kind === 'insert-column') {
+        expect(f.table.getRange(), 'column insertion changes the table range').toEqual({ ...initialRange, endColumn: 3 + count });
+        const columns = f.columns();
+        expect(columns.length, 'column metadata grows by count').toBe(3 + count);
+        expect(columns.slice(0, 1), 'metadata before the insertion is preserved').toEqual(oldColumns.slice(0, 1));
+        expect(columns.slice(1 + count), 'existing columns shift without metadata loss').toEqual(oldColumns.slice(1));
+        expect(f.cell(2, 1), 'preceding table column is unchanged').toBe('r2c1');
+        for (let i = 0; i < count; i++) expect(f.cell(2, 2 + i), 'new column slot is empty').toBeNull();
+        expect(f.cell(2, 2 + count), 'in-table cells move right at the requested index').toBe('r2c2');
+        expect(f.cell(4, 5 + count), 'trailing cells right of the table move right').toBe('r4c5');
+        expect(f.cell(6, 2), 'cells below the table are unaffected').toBe('r6c2');
+    } else {
+        expect(f.table.getRange(), 'column removal changes the table range').toEqual({ ...initialRange, endColumn: 3 - count });
