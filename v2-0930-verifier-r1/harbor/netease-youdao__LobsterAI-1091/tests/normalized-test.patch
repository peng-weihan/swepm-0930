+  const result = policy.toWireBinding({ kind: BindingKind.SessionKey, sessionKey: 'custom:key:1' });
+  expect(result.sessionTarget).toBe(SessionTarget.Isolated);
+  expect(result.sessionKey).toBe('custom:key:1');
