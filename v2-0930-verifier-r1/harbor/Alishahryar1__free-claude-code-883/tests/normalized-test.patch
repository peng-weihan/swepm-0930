+def test_anthropic_stream_engine_owns_provider_stream_state() -> None:
+    repo_root = Path(__file__).resolve().parents[2]
+    anthropic_root = repo_root / "core" / "anthropic"
+    streaming_root = anthropic_root / "streaming"
+
+    for removed in {
+        "sse.py",
+        "emitted_sse_tracker.py",
+        "stream_recovery.py",
+        "stream_recovery_session.py",
+    }:
+        assert not (anthropic_root / removed).exists()
+
+    # The task specifies this public package/API, not its internal file split.
+    from importlib import import_module
+
+    assert streaming_root.is_dir()
+    streaming = import_module("core.anthropic.streaming")
+    assert hasattr(streaming, "__path__")
+    for exported_name in (
+        "AnthropicStreamLedger",
+        "StreamBlockLedger",
+        "ToolBlockState",
+        "format_sse_event",
+        "map_stop_reason",
+    ):
+        assert callable(getattr(streaming, exported_name, None)), exported_name
+
+    headers = getattr(streaming, "ANTHROPIC_SSE_RESPONSE_HEADERS", None)
+    assert headers is not None
+    # Preserve the existing public response-header behavior, accepting any
+    # mapping implementation with the required lookups.
+    for name, value in {
+        "X-Accel-Buffering": "no",
+        "Cache-Control": "no-cache",
+        "Connection": "keep-alive",
+    }.items():
+        assert headers[name] == value
+
+    forbidden = (
+        "SSEBuilder",
+        "ContentBlockManager",
+        "ToolCallState",
+        "EmittedNativeSseTracker",
+        "StreamRecoverySession",
+        "OpenAIChatStreamRunner",
+        "AnthropicMessagesStreamRunner",
+    )
+    offenders: list[str] = []
+    for path in [
+        *anthropic_root.rglob("*.py"),
+        *(repo_root / "providers" / "transports").rglob("*.py"),
+    ]:
+        text = path.read_text(encoding="utf-8")
+        offenders.extend(
+            f"{path.relative_to(repo_root)}: {name}"
+            for name in forbidden
+            if name in text
+        )
+    assert sorted(offenders) == []
+
