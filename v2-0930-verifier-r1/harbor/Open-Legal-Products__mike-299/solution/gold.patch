+            role: "user",
+            content: "Stale stored question",
+          },
+        ],
+      }),
+    });
+  });
+  await page.route("**/word-chat/chat-2?*", async (route, request) => {
+    if (request.method() !== "GET") return route.fallback();
+    await route.fulfill({
+      status: 200,
+      contentType: "application/json",
+      body: JSON.stringify({
+        chat: makeChats(2)[1],
+        messages: [
+          {
+            id: "current-user",
+            role: "user",
+            content: "Current stored question",
