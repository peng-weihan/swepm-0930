+    if (request.method() !== "GET") return route.fallback();
+    firstDetailRequested = true;
+    await firstDetailGate;
+    await route.fulfill({
+      status: 200,
+      contentType: "application/json",
+      body: JSON.stringify({
+        chat: makeChats(1)[0],
+        messages: [
