+void test_circular_buffer_clear(void) {
+  printf("Testing circular buffer clear...\n");
+
+  SbSpectralCircularBuffer* cb = spectral_circular_buffer_create(4);
+  uint32_t layer0 = spectral_circular_buffer_add_layer(cb, 2);
