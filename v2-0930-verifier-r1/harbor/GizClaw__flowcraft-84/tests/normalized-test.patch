+
+	if err := n.ExecuteBoard(ectx, board); err != nil {
+		t.Fatalf("execute: %v", err)
+	}
+	hits, _ := board.GetVar("hits")
+	h, ok := hits.([]knowledge.Hit)
+	if !ok || len(h) == 0 {
