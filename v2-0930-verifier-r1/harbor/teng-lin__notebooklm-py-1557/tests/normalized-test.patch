+# Public behavior replaces only the two gold-new decode seams. Existing
+# base row-adapter tests above remain unchanged except the two new imports.
+from unittest.mock import AsyncMock, MagicMock
+
+from notebooklm._chat import ChatAPI
+from notebooklm.types import AskResult, ChatReference
+
+
+def make_public_chat(response):
+    rpc = MagicMock(rpc_call=AsyncMock(return_value=response))
+    return ChatAPI(
+        rpc=rpc,
+        transport=MagicMock(),
+        reqid=MagicMock(),
+        loop_guard=MagicMock(),
+        notebooks=MagicMock(get_source_ids=AsyncMock(return_value=[])),
+    )
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "payload,expected",
+    [
+        ([[["conv-abc"]]], "conv-abc"),
+        ([[["first"], ["second"]]], "first"),
+        (["noise", [None, [], [42], ["winner"]]], "winner"),
+        ([[[""]]], ""),
+        ([[[" spaced "]]], " spaced "),
+    ],
+)
+async def test_public_conversation_id_preserves_first_string(payload, expected):
+    assert await make_public_chat(payload).get_conversation_id("nb-marker") == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "payload", [None, [], "str", 42, {}, [[]], [[[]]], [[[42]]], {"unexpected": "dict"}]
+)
+async def test_public_conversation_id_soft_absence_keeps_diagnostics(payload, caplog):
+    with caplog.at_level("WARNING"):
+        result = await make_public_chat(payload).get_conversation_id("nb-marker")
+    assert result is None
+    # None is ordinary absence. Other unsuccessful shapes retain a warning,
+    # without fixing the logger name or exact diagnostic wording.
+    if payload is not None:
+        assert any(record.levelno >= 30 for record in caplog.records)
+
+
+def cited_answer():
+    return AskResult(
+        answer="Public answer marker [1].",
+        conversation_id="conversation-marker",
+        turn_number=1,
+        is_follow_up=False,
+        references=[ChatReference(source_id="source-marker", citation_number=1, chunk_id="chunk-marker", cited_text="A cited passage.", start_char=0, end_char=16)],
+        raw_response="",
+    )
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "payload,expected_id,expected_title",
+    [
+        ([["note-1", "content", None, None, "Server Title", "rich"]], "note-1", "Server Title"),
+        (["note-2", "content", None, None, "Flat Title"], "note-2", "Flat Title"),
+        ([["note-3", "content"]], "note-3", "Requested Title"),
+        ([["note-4", "c", None, None, 99]], "note-4", "Requested Title"),
+        ([["note-5", "c", None, None, None]], "note-5", "Requested Title"),
+        ([["note-6", "c", None, None, ""]], "note-6", ""),
+        ([["note-7", 1, 2]], "note-7", "Requested Title"),
+    ],
+)
+async def test_public_saved_chat_note_id_title_and_content(payload, expected_id, expected_title):
+    answer = cited_answer()
+    note = await make_public_chat(payload).save_answer_as_note("nb-marker", answer, title="Requested Title")
+    assert note.id == expected_id
+    assert note.title == expected_title
+    assert note.notebook_id == "nb-marker"
+    assert note.content == answer.answer
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("payload", [None, [], "str", 42, {}, {"k": 1}, [None], [42], [[]], [[7]], [[""]]])
+async def test_public_saved_chat_note_missing_id_keeps_error(payload):
+    with pytest.raises(RuntimeError):
+        await make_public_chat(payload).save_answer_as_note("nb-marker", cited_answer(), title="Requested Title")
