+from copy import deepcopy
+from unittest.mock import AsyncMock
+
+from notebooklm._research import ResearchAPI
+from notebooklm.exceptions import DecodingError
+from notebooklm.rpc import RPCMethod
+from tests._fixtures.fake_core import make_fake_core
+
+
+def _public_research_api(payload):
+    """Inject only RPC transport; execute the candidate's real public methods."""
+    rpc_call = AsyncMock(return_value=deepcopy(payload))
+    return ResearchAPI(make_fake_core(rpc_call=rpc_call)), rpc_call
+
