+"""Unexecuted draft: real CLI plus only new, test-owned public plugin files.
+
+Execution is not authorized by this file. An outer, reviewed runner must provide
+an isolated /data-backed writable source view, explicit logs/tmp/cache mounts,
+network isolation and a complete source-before/source-after manifest check.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import uuid
+
+
+def _sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _has_token(output, name):
+    return re.search(r"(?<!\w)" + re.escape(name) + r"(?!\w)", output) is not None
+
+
+def test_show_discovers_new_enabled_plugin_and_omits_disabled_and_unnamed():
+    # Explicit path from the future runner, never inferred from a private helper.
+    repo = Path.cwd().resolve(strict=True)
+    assert repo == Path("/testbed"), "Verifier must run from its fixed repository cwd"
+    sources = repo / "fetcher" / "sources"
+    assert sources.is_dir(), "The task explicitly requires fetcher/sources/"
+    assert not sources.is_symlink(), "Outer runner must validate the source view"
+    assert os.path.commonpath([str(repo), str(sources.resolve())]) == str(repo), (
+        "Public plugin directory resolves outside the isolated repository"
+    )
+    entry = repo / "proxyPool.py"
+    assert entry.is_file(), "The task explicitly requires proxyPool.py show"
+    token = uuid.uuid4().hex
+    names = {
+        "active": "VerifierEnabled" + token,
+        "disabled": "VerifierDisabled" + token,
+        "unnamed": "VerifierUnnamed" + token,
+    }
+    owned = []
+    cleanup_errors = []
+    try:
+        for kind, classname in names.items():
+            path = sources / ("verifier_owned_" + kind + "_" + token + ".py")
+            enabled = "    enabled = False\n" if kind == "disabled" else ""
+            # The enabled case deliberately inherits the required default True.
+            source_name = "" if kind == "unnamed" else "verifier_" + kind + "_" + token
+            data = (
+                "from fetcher.baseFetcher import BaseFetcher\n\n"
+                + "class " + classname + "(BaseFetcher):\n"
+                + "    name = " + repr(source_name) + "\n"
+                + "    url = 'https://fixture.invalid/'\n"
+                + enabled
+                + "    def fetch(self):\n"
+                + "        if False:\n"
+                + "            yield '192.0.2.1:8080'\n"
+            ).encode()
+            # O_EXCL: a collision never overwrites a candidate file.
+            with path.open("xb") as stream:
+                owned.append((path, _sha(data)))
+                receipt_name = os.environ.get("SWEPM_CLI_FIXTURE_RECEIPT")
+                if receipt_name:
+                    Path(receipt_name).write_text(json.dumps([{"path": str(p.relative_to(repo)), "sha256": h} for p, h in owned]) + "\n")
+                stream.write(data)
+        env = dict(os.environ)
+        env["PYTHONDONTWRITEBYTECODE"] = "1"
+        proc = subprocess.run(
+            [sys.executable, "-B", str(entry), "show"],
+            cwd=repo, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+            text=True, timeout=30, check=False,
+        )
+        # Preserve actual child output in pytest --capture=tee-sys native logs.
+        print("CLI_SHOW_EXIT", proc.returncode)
+        print("CLI_SHOW_STDOUT_BEGIN\n" + proc.stdout + "CLI_SHOW_STDOUT_END")
+        print("CLI_SHOW_STDERR_BEGIN\n" + proc.stderr + "CLI_SHOW_STDERR_END")
+        assert proc.returncode == 0, "Real CLI failed: " + proc.stderr
+        assert _has_token(proc.stdout, names["active"]), (
+            "CLI did not list the newly installed enabled public plugin: "
+            + names["active"] + "\n" + proc.stdout
+        )
+        assert not _has_token(proc.stdout, names["disabled"]), (
+            "CLI listed a disabled public plugin\n" + proc.stdout
+        )
+        assert not _has_token(proc.stdout, names["unnamed"]), (
+            "CLI listed a public plugin whose name is empty\n" + proc.stdout
+        )
+        # No hard-coded heading, indentation, migrated class names or count.
+        # Sorted discovery, exclusions and same-process reload are separate scope.
+    finally:
+        for path, expected_sha in reversed(owned):
+            try:
+                if path.is_symlink() or _sha(path.read_bytes()) != expected_sha:
+                    cleanup_errors.append("Owned fixture changed; retained: " + str(path))
+                else:
+                    path.unlink()
+            except OSError as exc:
+                cleanup_errors.append("Owned fixture cleanup failed: " + str(exc))
+        assert not cleanup_errors, "\n".join(cleanup_errors)
