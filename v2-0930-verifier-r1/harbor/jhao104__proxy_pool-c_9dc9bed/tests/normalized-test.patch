+    def test_preserves_order(self):
+        proxies = ["3.3.3.3:80", "1.1.1.1:80", "2.2.2.2:80", "3.3.3.3:80"]
+        result = list(BaseFetcher.yieldUniqueProxies(proxies))
+        assert result == ["3.3.3.3:80", "1.1.1.1:80", "2.2.2.2:80"]
