+def _prepared_html_response(request, html):
+    # Exercise the existing Requests -> WebRequest -> real lxml parser boundary.
+    # This fixture does not inspect any candidate module's import bindings.
+    from requests import Response
+    response = Response()
+    response.status_code = 200
+    response.url = request.url
+    response.request = request
+    response.encoding = "utf-8"
+    response.headers["Content-Type"] = "text/html; charset=utf-8"
+    response._content = html.encode("utf-8")
+    return response
+
+
+
+def _fetch_http_body(fetcher_class, body, json_response=False):
+    """Exercise the baseline HTTP transport and parser without module aliases."""
+    import json
+    from requests.sessions import Session
+
+    if json_response:
+        body = json.dumps(body)
+
+    def send(session, request, **kwargs):
+        response = _prepared_html_response(request, body)
+        if json_response:
+            response.headers["Content-Type"] = "application/json"
+        return response
+
+    with patch.object(Session, "send", autospec=True, side_effect=send):
+        return list(fetcher_class().fetch())
+
+
+def _zdaye_html_response(request, age_seconds):
+    # Use the same local-wall-clock semantics as the unchanged baseline.
+    # Generate the timestamp at request handling, away from the 300s boundary.
+    from datetime import datetime, timedelta
+    if request.url.rstrip("/").endswith("/detail/1"):
+        return _prepared_html_response(
+            request, _html_table([("1.2.3.4", "8080")]))
+    posted_at = (datetime.now() - timedelta(seconds=age_seconds)).strftime(
+        "%Y/%m/%d %H:%M:%S")
+    # Keep a valid detail page even for the old post: ignoring age must reach
+    # the existing empty-result assertion, rather than failing on malformed HTML.
+    return _prepared_html_response(
+        request,
+        '<span class="thread_time_info">' + posted_at + '</span>'
+        '<h3 class="thread_title"><a href="/detail/1">test</a></h3>')
+
+
+class TestZdayeFetcher(object):
+
+    @_source_case('zdaye')
+    def test_fetch_recent(self):
+        from requests.sessions import Session
+        ZdayeFetcher = _source_class('zdaye')
+
+        def send(session, request, **kwargs):
+            return _zdaye_html_response(request, age_seconds=120)
+
+        # No mocked datetime or sleep name. A one-page successful fetch may
+        # retain its baseline five-second sleep; that is allowed behavior.
+        with patch.object(Session, "send", autospec=True, side_effect=send):
+            result = list(ZdayeFetcher().fetch())
+        assert "1.2.3.4:8080" in result
+
+    @_source_case('zdaye')
