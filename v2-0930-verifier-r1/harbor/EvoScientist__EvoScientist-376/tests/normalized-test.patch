+
+    display_mod.request_stream_cancel(cancel_scope)
+    worker.join(2)
+
+    assert not worker.is_alive()
+    assert stream_closed.is_set()
+    assert tasks["closer"] is tasks["consumer"]
+    assert result["response"] == "[Stopped.]"
