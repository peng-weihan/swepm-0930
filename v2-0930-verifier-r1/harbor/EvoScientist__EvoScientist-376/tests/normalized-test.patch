+            interactive=True,
+            gateway=FakeGraphGateway(stream=stream),
+        )
+
+    assert result == "ok"
+    assert execution["thread"] == "evosci-stream-runtime"
+    assert isinstance(execution["loop"], asyncio.AbstractEventLoop)
+    assert not any(
