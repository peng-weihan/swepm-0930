+    async def _stalled_stream(_request):
+        tasks["consumer"] = asyncio.current_task()
+        stream_started.set()
+        try:
+            await asyncio.Event().wait()
+            if False:
+                yield {}
+        finally:
+            tasks["closer"] = asyncio.current_task()
