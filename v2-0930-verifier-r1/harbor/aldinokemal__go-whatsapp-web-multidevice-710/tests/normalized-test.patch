+}
+
+func (f *fakeConfigStore) SaveChatwootDeviceConfig(cfg *domainChatStorage.ChatwootDeviceConfig) error {
+	if cfg.ID == 0 {
+		f.nextID++
+		cfg.ID = f.nextID
+	}
+	clone := *cfg
+	f.configs[cfg.DeviceID] = &clone
+	return nil
+}
