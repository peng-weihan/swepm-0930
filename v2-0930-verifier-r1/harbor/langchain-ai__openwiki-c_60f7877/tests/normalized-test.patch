+  await invokeCli(fixture, 'present-explicit', args, port, true, 'closed');
+}, 160000);
+
+test('supports --port=NNNN form', async () => {
+  const fixture = await cliFixture('equals-port');
+  await ensureCandidateBuilt(fixture.root);
+  const requested = path.join(fixture.cwd, 'equals-wiki');
+  await mkdir(requested); await writeFile(path.join(requested, 'index.md'), '# Equals option\n');
+  // Keep the accepted range, explicit equals form, and next-available-port
+  // behavior together. The blocker is a socket reservation, not a fake app.
+  let port = 0;
+  for (let attempt = 0; attempt < 10; attempt++) {
+    const proposed = await unusedPort();
+    if (proposed >= 65535) continue;
+    try { await portInitiallyFree(proposed + 1); port = proposed; break; } catch { /* pick another pair */ }
+  }
+  if (!port) throw new Error('fixture could not find adjacent available ports');
+  const args = [requested, `--port=${port}`, '--no-open'];
+  await invokeCli(fixture, 'equals-port', args, port, true, 'closed');
+  const blocker = createServer();
+  try {
+    await new Promise<void>((resolve, reject) => {
+      blocker.once('error', reject); blocker.listen(port, '127.0.0.1', resolve);
+    });
+    await invokeCli(fixture, 'equals-port-conflict', args, port + 1, true, 'closed');
+  } finally {
+    if (blocker.listening) await new Promise<void>((resolve, reject) => blocker.close(e => e ? reject(e) : resolve()));
+  }
+}, 160000);
