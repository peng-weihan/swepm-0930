new file mode 100644
index 0000000..1c74ea8
--- /dev/null
+++ b/test/visualize-graph.test.ts
@@ -0,0 +1,135 @@
+import { mkdtemp, mkdir, rm, writeFile, symlink } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, test } from "vitest";
+import {
+  buildGraph,
+  firstHeading,
+  splitFrontmatter,
+} from "../src/visualize/graph.ts";
+
+// The task names splitFrontmatter and its returned metadata/body, but does not
+// name their return slots. Inspect only direct returned values; do not parse the
+// input, adapt the candidate, or constrain keys to two known implementations.
+function directReturnedValues(result: unknown): unknown[] {
+  expect(result).not.toBeNull();
+  expect(typeof result).toBe("object");
+  return Object.values(result as Record<string, unknown>);
+}
+
+const tempDirs: string[] = [];
+
+async function makeWiki(files: Record<string, string>): Promise<string> {
+  const root = await mkdtemp(path.join(tmpdir(), "openwiki-viz-"));
+  tempDirs.push(root);
+  for (const [rel, content] of Object.entries(files)) {
+    const full = path.join(root, rel);
+    await mkdir(path.dirname(full), { recursive: true });
+    await writeFile(full, content, "utf8");
+  }
+  return root;
+}
+
+afterEach(async () => {
+  await Promise.all(
+    tempDirs.splice(0).map((dir) => rm(dir, { force: true, recursive: true })),
+  );
+});
+
+describe("splitFrontmatter", () => {
+  test("parses scalars, inline lists, and dashed lists", () => {
+    const parts = directReturnedValues(splitFrontmatter(
+      [
+        "---",
+        "type: Reference",
+        'title: "Quoted Title"',
+        "tags: [alpha, beta]",
+        "authors:",
+        "  - Ada",
+        "  - Grace",
+        "---",
+        "# Heading",
+        "",
+        "Body text.",
+      ].join("\n"),
+    ));
+    expect(parts).toContainEqual(expect.objectContaining({
+      type: "Reference",
+      title: "Quoted Title",
+      tags: ["alpha", "beta"],
+      authors: ["Ada", "Grace"],
+    }));
+    expect(parts.some(value => typeof value === "string" && value.startsWith("# Heading"))).toBe(true);
+  });
+
+  test("returns the raw body when there is no frontmatter", () => {
+    const parts = directReturnedValues(splitFrontmatter("# Just markdown\n"));
+    expect(parts).toContainEqual({});
+    expect(parts).toContain("# Just markdown\n");
+  });
+});
+
+describe("firstHeading", () => {
+  test("returns the first H1 or undefined", () => {
+    expect(firstHeading("intro\n# Title\n")).toBe("Title");
+    expect(firstHeading("no heading here")).toBeUndefined();
+  });
+});
+
+describe("buildGraph", () => {
+  test("builds nodes, resolves links to edges, and records backlinks", async () => {
+    const root = await makeWiki({
+      "index.md": "---\ntype: Section\n---\n# Files\n[Arch](architecture.md)\n",
+      "architecture.md":
+        "---\ntype: Reference\ntitle: Architecture\n---\n# Architecture\nSee [home](index.md).\n",
+      "INSTRUCTIONS.md": "scaffolding, must be excluded",
+    });
+
+    const graph = await buildGraph(root);
+
+    // INSTRUCTIONS.md is excluded; the two real pages remain.
+    expect(graph.nodes.map((n) => n.id).sort()).toEqual([
+      "architecture",
+      "index",
+    ]);
+    // Root index.md is titled "Home", not its generic "# Files" heading.
+    expect(graph.nodes.find((n) => n.id === "index")?.title).toBe("Home");
+    expect(graph.nodes.find((n) => n.id === "architecture")?.title).toBe(
+      "Architecture",
+    );
+    // Two directed edges, one each way.
+    expect(graph.edges).toContainEqual({
+      source: "index",
+      target: "architecture",
+    });
+    expect(graph.edges).toContainEqual({
+      source: "architecture",
+      target: "index",
+    });
+    // Backlinks are recorded on the target node.
+    expect(
+      graph.nodes.find((n) => n.id === "architecture")?.backlinks,
+    ).toContain("index");
+  });
+
+  test("ignores links to non-existent pages and self-links", async () => {
+    const root = await makeWiki({
+      "a.md": "# A\n[missing](nope.md) and [self](a.md)\n",
+    });
+    const graph = await buildGraph(root);
+    expect(graph.edges).toEqual([]);
+  });
+
+  test("does not follow a symlink that escapes the wiki root", async () => {
+    const secret = await mkdtemp(path.join(tmpdir(), "openwiki-secret-"));
+    tempDirs.push(secret);
+    await writeFile(path.join(secret, "leak.md"), "# Secret\n", "utf8");
+
+    const root = await makeWiki({ "index.md": "# Home\n" });
+    // A symlink inside the wiki pointing outside it must not be collected.
+    await symlink(secret, path.join(root, "escape"));
+
+    const graph = await buildGraph(root);
+    expect(graph.nodes.some((n) => n.id.includes("leak"))).toBe(false);
+  });
+});
diff --git a/test/visualize-server.test.ts b/test/visualize-server.test.ts
new file mode 100644
index 0000000..469972b
--- /dev/null
+++ b/test/visualize-server.test.ts
@@ -0,0 +1,370 @@
+// Draft replacement for the original one-test fake server: build the candidate
+// through its package script, then exercise its public openwiki CLI entry.
+import { readFile, mkdtemp, writeFile, mkdir, chmod, symlink } from 'node:fs/promises';
+import { createServer } from 'node:net';
+import { request } from 'node:http';
+import { spawn, type ChildProcess } from 'node:child_process';
+import path from 'node:path';
+import { tmpdir } from 'node:os';
+import { expect, test } from 'vitest';
+
+const pause = (ms: number) => new Promise<void>(resolve => setTimeout(resolve, ms));
+
+async function unusedPort() {
+  const probe = createServer(); // Allocates a port only; never handles HTTP.
+  await new Promise<void>((resolve, reject) => {
+    probe.once('error', reject);
+    probe.listen(0, '127.0.0.1', resolve);
+  });
+  const bound = probe.address();
+  if (!bound || typeof bound === 'string') throw new Error('port allocation failed');
+  const port = bound.port;
+  await new Promise<void>((resolve, reject) => probe.close(error => error ? reject(error) : resolve()));
+  if (port < 1024 || port > 65535) throw new Error('ephemeral port outside CLI contract');
+  return port;
+}
+
+function get(port: number, rawPath: string): Promise<{status: number; body: string}> {
+  return new Promise((resolve, reject) => {
+    // Preserve traversal spelling; URL normalization must not erase the probe.
+    const req = request({host: '127.0.0.1', port, path: rawPath, method: 'GET'}, res => {
+      let size = 0;
+      const chunks: Buffer[] = [];
+      res.on('data', chunk => {
+        const b = Buffer.from(chunk); size += b.length;
+        if (size > 1024 * 1024) { res.destroy(new Error('response limit')); return; }
+        chunks.push(b);
+      });
+      res.once('error', reject);
+      res.once('end', () => resolve({status: res.statusCode ?? 0, body: Buffer.concat(chunks).toString('utf8')}));
+    });
+    req.setTimeout(1000, () => req.destroy(new Error('HTTP timeout')));
+    req.once('error', reject);
+    req.end();
+  });
+}
+
+async function stop(child: ChildProcess) {
+  for (const signal of ['SIGINT', 'SIGTERM', 'SIGKILL'] as const) {
+    if (child.exitCode !== null || child.signalCode !== null) return;
+    child.kill(signal);
+    const until = Date.now() + 2000;
+    while (child.exitCode === null && child.signalCode === null && Date.now() < until) await pause(20);
+  }
+  if (child.exitCode === null && child.signalCode === null) throw new Error('CLI child not reaped');
+}
+
+
+async function buildCandidate(root: string, evidence: string) {
+  // Keep a failed build in this one test; unrelated target tests still collect.
+  const child = spawn('pnpm', ['run', 'build'], {
+    cwd: root, detached: true, stdio: ['ignore', 'pipe', 'pipe'],
+    env: {...process.env, COREPACK_ENABLE_NETWORK: '0'},
+  });
+  let failure: Error | undefined;
+  const chunks: Buffer[][] = [[], []];
+  const bytes = [0, 0];
+  const killGroup = () => {
+    if (!child.pid) return;
+    try { process.kill(-child.pid, 'SIGKILL'); }
+    catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ESRCH') throw error; }
+  };
+  child.once('error', error => { failure = error; });
+  [child.stdout!, child.stderr!].forEach((stream, index) => stream.on('data', chunk => {
+    const b = Buffer.from(chunk); bytes[index] += b.length;
+    if (bytes[index] > 1024 * 1024) {
+      failure = new Error('candidate build output exceeded 1 MiB per stream');
+      killGroup();
+    } else chunks[index].push(b);
+  }));
+  const timer = setTimeout(() => {
+    failure = new Error('candidate package build timed out after 120s');
+    killGroup();
+  }, 120000);
+  let code: number | null = null;
+  try {
+    code = await new Promise<number | null>(resolve => child.once('close', resolve));
+  } finally {
+    clearTimeout(timer);
+    // Kill the created process group even if its leader has already exited.
+    try { killGroup(); }
+    finally {
+      await writeFile(path.join(evidence, 'build.stdout'), Buffer.concat(chunks[0]));
+      await writeFile(path.join(evidence, 'build.stderr'), Buffer.concat(chunks[1]));
+    }
+  }
+  if (failure || code !== 0) {
+    throw new Error(`candidate package build failed (${code}): ${failure?.message ?? ''}\n${Buffer.concat(chunks[0]).toString('utf8')}\n${Buffer.concat(chunks[1]).toString('utf8')}`);
+  }
+}
+
+async function publicOpenwikiBin(root: string): Promise<string> {
+  const pkg = JSON.parse(await readFile(path.join(root, 'package.json'), 'utf8'));
+  // Support both standard package.json bin forms; do not require dist/cli.js.
+  const bin = typeof pkg.bin === 'string' && typeof pkg.name === 'string'
+    && pkg.name.split('/').pop() === 'openwiki' ? pkg.bin : pkg.bin?.openwiki;
+  if (typeof bin !== 'string' || bin.length === 0) throw new Error('package.json must expose the public openwiki bin');
+  return path.resolve(root, bin);
+}
+
+// All runtime cases live in this one sequential test file, and share one
+// successful current-candidate native build. No source changes between cases.
+// No second suite may run pnpm clean concurrently against the same dist tree.
+let candidateBuild: Promise<void> | undefined;
+async function ensureCandidateBuilt(evidence: string) {
+  candidateBuild ??= buildCandidate(process.cwd(), evidence);
+  await candidateBuild;
+}
+
+test('actual visualize CLI binds loopback and serves only fixed routes', async () => {
+  const wiki = await mkdtemp(path.join(tmpdir(), 'swepm-openwiki-real-server-'));
+  await writeFile(path.join(wiki, 'index.md'), '# Diagnostic home\n');
+  await ensureCandidateBuilt(wiki);
+  const cli = await publicOpenwikiBin(process.cwd());
+  const port = await unusedPort();
+  const child = spawn(process.execPath, [cli, 'visualize', wiki, '--port', String(port), '--no-open'], {
+    cwd: process.cwd(), stdio: ['ignore', 'pipe', 'pipe'],
+    env: {...process.env, OPENWIKI_TELEMETRY_DISABLED: '1', CI: '1'},
+  });
+  let output = '';
+  let launchError: Error | undefined;
+  child.once('error', error => { launchError = error; });
+  const receive = (chunk: Buffer) => {
+    output += chunk.toString('utf8');
+    if (Buffer.byteLength(output) > 128 * 1024) {
+      launchError = new Error('CLI diagnostic output cap');
+      child.kill('SIGKILL');
+    }
+  };
+  child.stdout!.on('data', receive); child.stderr!.on('data', receive);
+  try {
+    let home: Awaited<ReturnType<typeof get>> | undefined;
+    const deadline = Date.now() + 15000;
+    while (Date.now() < deadline) {
+      if (launchError || child.exitCode !== null || child.signalCode !== null) {
+        throw new Error(`CLI startup failed: ${launchError?.message ?? child.exitCode ?? child.signalCode}\n${output}`);
+      }
+      try { home = await get(port, '/'); break; } catch { await pause(100); }
+    }
+    if (!home) throw new Error(`real CLI did not listen within 15s\n${output}`);
+    expect(home.status, 'real app shell').toBe(200);
+    expect(home.body.length, 'real app shell is nonempty').toBeGreaterThan(0);
+    // Linux socket state observes the binding, without coupling to HOST or a
+    // private server helper. A wildcard listener still answers localhost HTTP.
+    const tcp = await readFile('/proc/net/tcp', 'utf8');
+    const listeners = tcp.split('\n').slice(1).map(line => line.trim().split(/\s+/))
+      .filter(fields => fields[3] === '0A' && fields[1]?.split(':')[1] === port.toString(16).toUpperCase().padStart(4, '0'));
+    expect(new Set(listeners.map(fields => fields[1])), 'actual listening address').toEqual(new Set([`0100007F:${port.toString(16).toUpperCase().padStart(4, '0')}`]));
+    const tcp6 = await readFile('/proc/net/tcp6', 'utf8');
+    const samePort6 = tcp6.split('\n').slice(1).map(line => line.trim().split(/\s+/))
+      .filter(fields => fields[3] === '0A' && fields[1]?.split(':')[1] === port.toString(16).toUpperCase().padStart(4, '0'));
+    const loopback6 = new Set(['00000000000000000000000001000000', '0000000000000000FFFF00000100007F']);
+    expect(samePort6.every(fields => loopback6.has(fields[1].split(':')[0])), 'no same-port non-loopback IPv6 listener').toBe(true);
+    for (const route of ['/not-a-public-route', '/..%2f..%2fetc%2fpasswd']) {
+      const res = await get(port, route);
+      expect(res.status, `production rejects ${route}`).toBe(404);
+      expect(['Not found', '404 Not found'], `production error body for ${route}`).toContain(res.body);
+    }
+  } finally {
+    // Retain fixture files and output under persistent TMPDIR for diagnosis.
+    await stop(child);
+    await writeFile(path.join(wiki, 'cli-output.log'), output);
+  }
+}, 160000);
+
+// UNEXECUTED PROTOTYPE: the browser sink needs its own controls before this
+// complete replacement can be enabled. Existing formal tests are untouched.
+const browserRecorder = "#!/usr/bin/env node\n// Test-only prototype. No browser is installed or launched by this recorder.\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst entry = path.basename(process.argv[1]);\nconst args = process.argv.slice(2);\nconst urls = entry === 'gio' && args[0] === 'open' ? args.slice(1) : args;\nif (entry === 'gio' && args[0] !== 'open') process.exit(64);\nif (urls.length !== 1 || urls[0].length > 2048) process.exit(64);\nconst file = process.env.SWEPM_BROWSER_EVENTS;\nif (!file || !path.isAbsolute(file)) process.exit(64);\nfs.appendFileSync(file, JSON.stringify({entry, url: urls[0]}) + '\\n');\n";
+
+type BrowserEvent = {entry: string; url: string};
+type CliFixture = {root: string; cwd: string; browserBin: string; events: string};
+
+async function cliFixture(label: string): Promise<CliFixture> {
+  const root = await mkdtemp(path.join(tmpdir(), `swepm-openwiki-cli-${label}-`));
+  const cwd = path.join(root, 'cwd');
+  const browserBin = path.join(root, 'browser-bin');
+  const events = path.join(root, 'browser-events.jsonl');
+  await mkdir(cwd); await mkdir(browserBin); await writeFile(events, '');
+  const recorder = path.join(browserBin, 'record-browser.cjs');
+  await writeFile(recorder, browserRecorder); await chmod(recorder, 0o700);
+  // Public OS entries, not candidate modules or child_process method names.
+  // BROWSER covers handlers that delegate to a configured browser. PATH shims
+  // cover ordinary Linux launchers irrespective of exec/execFile/spawn family.
+  for (const name of ['xdg-open', 'gio', 'sensible-browser', 'x-www-browser', 'www-browser']) {
+    await symlink('record-browser.cjs', path.join(browserBin, name));
+  }
+  return {root, cwd, browserBin, events};
+}
+
+function fixtureEnv(fixture: CliFixture): NodeJS.ProcessEnv {
+  // Keep runtime/cache locations, not provider credentials from a solver env.
+  // Do not change HOME or any existing system settings/default-browser config.
+  const env: NodeJS.ProcessEnv = {};
+  for (const key of ['PATH', 'TMPDIR', 'XDG_CACHE_HOME', 'NODE_COMPILE_CACHE', 'COREPACK_HOME', 'LANG', 'LC_ALL', 'TERM']) {
+    if (process.env[key] !== undefined) env[key] = process.env[key];
+  }
+  return {...env, PATH: `${fixture.browserBin}:${env.PATH ?? ''}`,
+    BROWSER: path.join(fixture.browserBin, 'record-browser.cjs'),
+    SWEPM_BROWSER_EVENTS: fixture.events,
+    OPENWIKI_TELEMETRY_DISABLED: '1', CI: '1', COREPACK_ENABLE_NETWORK: '0'};
+}
+
+async function browserEvents(fixture: CliFixture): Promise<BrowserEvent[]> {
+  const contents = await readFile(fixture.events, 'utf8');
+  if (Buffer.byteLength(contents) > 64 * 1024) throw new Error('browser event evidence cap');
+  return contents.split('\n').filter(Boolean).map(line => {
+    const row = JSON.parse(line);
+    if (typeof row.entry !== 'string' || typeof row.url !== 'string') throw new Error('bad browser evidence');
+    return row;
+  });
+}
+
+async function portInitiallyFree(port: number) {
+  const probe = createServer();
+  try {
+    await new Promise<void>((resolve, reject) => {
+      probe.once('error', reject); probe.listen(port, '127.0.0.1', resolve);
+    });
+  } catch (error) {
+    throw new Error(`fixture cannot reserve required initial port ${port}: ${String(error)}`);
+  } finally {
+    if (probe.listening) await new Promise<void>((resolve, reject) => probe.close(e => e ? reject(e) : resolve()));
+  }
+}
+
+async function assertLoopbackSocket(port: number) {
+  const hex = port.toString(16).toUpperCase().padStart(4, '0');
+  const tcp = await readFile('/proc/net/tcp', 'utf8');
+  const listeners = tcp.split('\n').slice(1).map(line => line.trim().split(/\s+/))
+    .filter(fields => fields[3] === '0A' && fields[1]?.split(':')[1] === hex);
+  expect(new Set(listeners.map(fields => fields[1]))).toEqual(new Set([`0100007F:${hex}`]));
+  const tcp6 = await readFile('/proc/net/tcp6', 'utf8');
+  const extra = tcp6.split('\n').slice(1).map(line => line.trim().split(/\s+/))
+    .filter(fields => fields[3] === '0A' && fields[1]?.split(':')[1] === hex);
+  const local6 = new Set(['00000000000000000000000001000000', '0000000000000000FFFF00000100007F']);
+  expect(extra.every(fields => local6.has(fields[1].split(':')[0]))).toBe(true);
+}
+
+async function invokeCli(
+  fixture: CliFixture, label: string, args: string[], port: number,
+  expectLaunch: boolean, browser: 'open' | 'closed',
+) {
+  const cli = await publicOpenwikiBin(process.cwd());
+  const before = (await browserEvents(fixture)).length;
+  const child = spawn(process.execPath, [cli, 'visualize', ...args], {
+    cwd: fixture.cwd, stdio: ['ignore', 'pipe', 'pipe'], env: fixtureEnv(fixture),
+  });
+  let output = ''; let launchError: Error | undefined;
+  child.once('error', error => { launchError = error; });
+  const receive = (chunk: Buffer) => {
+    output += chunk.toString('utf8');
+    if (Buffer.byteLength(output) > 128 * 1024) {
+      launchError = new Error('CLI output evidence cap'); child.kill('SIGKILL');
+    }
+  };
+  child.stdout!.on('data', receive); child.stderr!.on('data', receive);
+  try {
+    let home: Awaited<ReturnType<typeof get>> | undefined;
+    const until = Date.now() + 15000;
+    while (Date.now() < until) {
+      if (launchError) throw launchError;
+      if (child.exitCode !== null || child.signalCode !== null) break;
+      try { home = await get(port, '/'); break; } catch { await pause(50); }
+    }
+    if (!expectLaunch) {
+      expect(home, 'missing requested directory must not serve a fallback directory').toBeUndefined();
+      expect(child.signalCode, 'missing directory must fail normally').toBeNull();
+      expect(child.exitCode, `missing-directory CLI did not exit: ${output}`).not.toBeNull();
+      expect(child.exitCode).not.toBe(0);
+      expect(output.trim(), 'missing-directory diagnostic exists').not.toBe('');
+      // Do not demand the gold diagnostic wording or exact absolute-path format.
+      expect((await browserEvents(fixture)).slice(before)).toEqual([]);
+      return;
+    }
+    expect(child.exitCode, output).toBeNull(); expect(child.signalCode, output).toBeNull();
+    expect(home, `CLI did not serve the expected port: ${output}`).toBeDefined();
+    expect(home!.status).toBe(200); expect(home!.body.length).toBeGreaterThan(0);
+    await assertLoopbackSocket(port);
+    // This is a finite startup observation, not a proof about arbitrary future
+    // delayed side effects. No private banner or invented graph endpoint used.
+    const browserUntil = Date.now() + 1500;
+    let observed: BrowserEvent[] = [];
+    do {
+      observed = (await browserEvents(fixture)).slice(before);
+      await pause(50);
+    } while (Date.now() < browserUntil);
+    observed = (await browserEvents(fixture)).slice(before);
+    if (browser === 'closed') expect(observed, '--no-open must suppress browser requests').toEqual([]);
+    else {
+      let openedServedUrl = false;
+      for (const event of observed) {
+        try {
+          const url = new URL(event.url);
+          // Do not require the gold URL spelling or app-shell route spelling.
+          // Other host aliases need fixture review before scoring, not a claim
+          // that the implementation is invalid merely for choosing an alias.
+          if (url.protocol !== 'http:' || Number(url.port) !== port
+            || !['127.0.0.1', 'localhost'].includes(url.hostname)) continue;
+          const opened = await get(port, `${url.pathname}${url.search}`);
+          if (opened.status === 200 && opened.body.length > 0) openedServedUrl = true;
+        } catch { /* malformed/wrong/dead URL is not successful browser dispatch */ }
+      }
+      expect(openedServedUrl, 'default command requests an actually served loopback URL').toBe(true);
+    }
+  } finally {
+    await stop(child);
+    await writeFile(path.join(fixture.root, `${label}.cli-output.log`), output);
+  }
+}
+
+test('defaults: openwiki dir, port 4321, opens the browser', async () => {
+  const fixture = await cliFixture('default');
+  await ensureCandidateBuilt(fixture.root);
+  await portInitiallyFree(4321);
+  await invokeCli(fixture, 'missing-default', [], 4321, false, 'closed');
+  const wiki = path.join(fixture.cwd, 'openwiki');
+  await mkdir(wiki); await writeFile(path.join(wiki, 'index.md'), '# Default wiki\n');
+  await invokeCli(fixture, 'present-default', [], 4321, true, 'open');
+}, 160000);
+
+test('accepts a positional dir, --port, and --no-open', async () => {
+  const fixture = await cliFixture('explicit');
+  await ensureCandidateBuilt(fixture.root);
