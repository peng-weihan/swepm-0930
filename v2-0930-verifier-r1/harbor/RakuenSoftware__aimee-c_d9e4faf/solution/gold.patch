+/* Copy one fixed-width, NUL-padded field out of the response. */
+static inline void aimee_delegates_handoff_field(const uint8_t *in, size_t at, size_t width,
+                                                 char *out, size_t cap)
+{
+   size_t n = 0;
+   while (n < width && in[at + n] != 0)
+      ++n;
+   if (n >= cap)
+      n = cap ? cap - 1 : 0;
+   if (cap)
+   {
+      memcpy(out, in + at, n);
+      out[n] = '\0';
+   }
+}
