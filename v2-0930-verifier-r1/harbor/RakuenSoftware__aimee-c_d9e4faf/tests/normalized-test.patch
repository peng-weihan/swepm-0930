-   test_basic();
-   test_content_prefix();
-   test_two_blocks();
-   test_cross_block_name_not_borrowed();
-   test_normalize_name();
-   test_no_tool_call();
-   test_brace_in_string();
-   test_invoke_format();
-   test_qwen_function_format();
-   test_mistral_format();
-   test_channel_arguments_are_an_object();
