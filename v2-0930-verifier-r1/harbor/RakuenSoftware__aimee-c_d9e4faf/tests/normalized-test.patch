-    * resurface as a second content value. */
-   memset(&r, 0, sizeof(r));
-   n = xml_parse_tool_calls(
-       "first<tool_call><name>bash</name><arguments>{\"a\":1}</arguments></tool_call>"
-       "middle<tool_call><name>read</name><arguments>{\"b\":2}</arguments></tool_call>",
-       &r);
