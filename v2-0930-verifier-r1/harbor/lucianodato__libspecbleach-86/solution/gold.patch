-      break;
-    case MASKING_THRESHOLDS:
-      masking_thresholds(self, spectrum, noise_spectrum, alpha, beta,
-                         parameters);
-      break;
-
-    case NO_SCALING:
-      for (uint32_t k = 0U; k < self->real_spectrum_size; k++) {
-        alpha[k] = self->alpha_minimun;
-        beta[k] = self->beta_minimun;
-      }
-      break;
-
-    default:
-      break;
-  }
-
-  return true;
-}
